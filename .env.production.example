# -----------------------------------------------------------------------------
# Nganzi Coffee Shop — Production Environment Template
# -----------------------------------------------------------------------------
# Copy this file to .env on your production server:
#   cp .env.production.example .env
#
# IMPORTANT:
# - APP_ENV must remain "production"
# - APP_DEBUG must remain "false"
# - Run 'php artisan key:generate' after setting up .env
# - Never commit your real production .env with passwords or secrets to Git.
# -----------------------------------------------------------------------------

APP_NAME="Nganzi Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nganzicoffee.com

# URL of the main Nganzi marketing website
MARKETING_SITE_URL=https://nganzicoffee.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: Daily rotated log files in storage/logs/
LOG_CHANNEL=daily
LOG_LEVEL=notice

# -----------------------------------------------------------------------------
# Database (MySQL 8.0+)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nganzi_coffee
DB_USERNAME=nganzi_app
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Sessions, Cache, and Queues
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nganzicoffee.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail Configuration (Transactional Emails)
# -----------------------------------------------------------------------------
# Supported drivers: smtp, ses, mailgun, postmark, resend
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SMTP_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@nganzicoffee.com"
MAIL_FROM_NAME="Nganzi Coffee"

# -----------------------------------------------------------------------------
# Frontend Build Environment (Passed to Vite at build time)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_MARKETING_SITE_URL="${MARKETING_SITE_URL}"

# -----------------------------------------------------------------------------
# Shop Configuration
# -----------------------------------------------------------------------------
# Currency code displayed to customers (UGX, USD)
SHOP_CURRENCY=UGX

# Flat delivery fee in minor currency units (e.g. 5000 UGX = 5000)
SHOP_DELIVERY_FEE=0
SHOP_FREE_DELIVERY_ABOVE=0

# Optional comma-separated delivery areas (leave empty for unrestricted)
SHOP_DELIVERY_AREAS=

# Unpaid order reservation window (in hours) before stock is returned
SHOP_INVENTORY_RESERVATION_HOURS=24

# Tax settings
SHOP_TAX_ENABLED=false
SHOP_TAX_RATE=0
SHOP_TAX_INCLUSIVE=true

# Low-stock warning threshold for admin notifications
SHOP_LOW_STOCK_THRESHOLD=5

# Payment Provider: manual | flutterwave | pesapal | stripe
PAYMENT_PROVIDER=manual
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Product image storage disk: public | s3
MEDIA_DISK=public
MEDIA_MAX_KB=4096

# S3 Configuration (if MEDIA_DISK is set to s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Support contact information shown on customer order emails
SHOP_SUPPORT_EMAIL="info@nganzicoffee.com"
SHOP_SUPPORT_PHONE="+256773211079"

# Notification settings
NOTIFY_MAIL_ENABLED=true
NOTIFY_SMS_ENABLED=false
NOTIFY_SMS_DRIVER=log
NOTIFY_QUEUE=default

# Optional privacy-first analytics (e.g. Plausible or Umami)
ANALYTICS_SCRIPT_SRC=
ANALYTICS_SITE_ID=
