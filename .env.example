APP_NAME="Nganzi Coffee"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL of the main Nganzi marketing website (used for cross-links)
MARKETING_SITE_URL=https://nganzicoffee.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nganzi_coffee
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@nganzicoffee.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_MARKETING_SITE_URL="${MARKETING_SITE_URL}"

# -----------------------------------------------------------------------
# Shop configuration — confirm all values with the business before launch
# -----------------------------------------------------------------------

# Currency code displayed to customers (e.g. UGX, USD). UNCONFIRMED.
SHOP_CURRENCY=UGX

# Delivery fee in minor currency units; free threshold 0 disables free delivery.
SHOP_DELIVERY_FEE=0
SHOP_FREE_DELIVERY_ABOVE=0
# Optional comma-separated eligible areas; blank leaves areas unrestricted.
SHOP_DELIVERY_AREAS=
# Unpaid orders hold stock for this many hours before it is released.
SHOP_INVENTORY_RESERVATION_HOURS=24

# Leave tax disabled until applicability and treatment are confirmed.
SHOP_TAX_ENABLED=false
SHOP_TAX_RATE=0
SHOP_TAX_INCLUSIVE=true

# Low-stock warning threshold (units). Adjust per business preference.
SHOP_LOW_STOCK_THRESHOLD=5

# Payment provider: manual | flutterwave | pesapal | stripe
# Set to "manual" until a provider is confirmed and integrated.
PAYMENT_PROVIDER=manual

# Payment provider credentials — fill in production secrets via your
# host's secret manager; never commit real values here.
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Product image storage disk: public | s3
# Use "public" locally; switch to "s3" (or equivalent) in production.
MEDIA_DISK=public

# Maximum product image upload size in kilobytes.
MEDIA_MAX_KB=4096

# Customer support contact shown in order emails (leave blank until confirmed).
SHOP_SUPPORT_EMAIL=
SHOP_SUPPORT_PHONE=

# Operational notifications (SMS stays disabled until a provider is approved).
NOTIFY_MAIL_ENABLED=true
NOTIFY_SMS_ENABLED=false
NOTIFY_SMS_DRIVER=log
NOTIFY_QUEUE=default

# Optional privacy-appropriate storefront traffic analytics (e.g. Plausible/Umami).
# Never loaded on /admin routes; kept separate from order/payment records.
ANALYTICS_SCRIPT_SRC=
ANALYTICS_SITE_ID=
